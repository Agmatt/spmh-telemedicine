---
import BaseHead from '../components/layout/BaseHead.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Section { id: string; label: string }
interface Props {
  title: string;
  description: string;
  lastUpdated: string;
  version: string;
  draft?: boolean;
  sections: Section[];
}
const { title, description, lastUpdated, version, draft = false, sections } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://telemedicine.spmh.co.ke').toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://telemedicine.spmh.co.ke' },
        { '@type': 'ListItem', position: 2, name: 'Legal', item: 'https://telemedicine.spmh.co.ke/legal/privacy' },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    },
    {
      '@type': 'WebPage',
      name: `${title} — SPMH Telemedicine`,
      url: canonical,
      description,
      dateModified: lastUpdated,
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} — SPMH Telemedicine`} description={description} canonical={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="min-h-screen bg-white text-slate-900">
    {draft && (
      <div class="border-b border-gold/30 bg-gold/10">
        <div class="mx-auto flex max-w-7xl items-start gap-3 px-4 py-3 text-xs text-slate-800 md:px-6 lg:px-8">
          <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-gold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          <p><strong class="font-semibold">Draft v{version}, pending legal review.</strong> This document reflects SPMH's current data practices and will be finalised by Kenyan legal counsel before public launch. If you have questions in the interim, contact <a href="mailto:dpo@spmh.co.ke" class="underline">dpo@spmh.co.ke</a>.</p>
        </div>
      </div>
    )}

    <Navbar />

    <main>
      <!-- Hero -->
      <section class="border-b border-border bg-white">
        <div class="mx-auto max-w-7xl px-4 pt-10 pb-10 md:px-6 md:pt-14 md:pb-12 lg:px-8">
          <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2 text-xs text-muted">
              <li><a href="/" class="hover:text-primary">Home</a></li>
              <li aria-hidden="true">/</li>
              <li><a href="/legal/privacy" class="hover:text-primary">Legal</a></li>
              <li aria-hidden="true">/</li>
              <li class="font-semibold text-slate-700">{title}</li>
            </ol>
          </nav>

          <h1 class="mt-6 font-display-bold text-4xl text-secondary md:text-5xl">{title}</h1>
          <div class="mt-4 h-px w-12 bg-gold" aria-hidden="true"></div>

          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted">
            <span><strong class="font-semibold text-slate-700">Version:</strong> {version}</span>
            <span class="hidden sm:inline" aria-hidden="true">·</span>
            <span><strong class="font-semibold text-slate-700">Last updated:</strong> {lastUpdated}</span>
            <span class="hidden sm:inline" aria-hidden="true">·</span>
            <span>Applies to <strong class="font-semibold text-slate-700">telemedicine.spmh.co.ke</strong></span>
          </div>
        </div>
      </section>

      <!-- Body -->
      <section class="bg-white">
        <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-[240px_1fr] lg:gap-16">

            <!-- Sidebar TOC -->
            <aside class="lg:sticky lg:top-24 lg:h-fit">
              <!-- Mobile: collapsible -->
              <details class="lg:hidden rounded-xl border border-border bg-surface/50 p-4">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-slate-800">
                  On this page
                  <svg class="h-4 w-4 text-muted transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <nav class="mt-3 border-t border-border pt-3">
                  <ul class="space-y-1.5">
                    {sections.map((s) => (
                      <li><a href={`#${s.id}`} class="block rounded-md px-2 py-1 text-xs text-slate-600 hover:bg-white hover:text-primary">{s.label}</a></li>
                    ))}
                  </ul>
                </nav>
              </details>

              <!-- Desktop: sticky -->
              <div class="hidden lg:block">
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-muted">On this page</p>
                <nav class="mt-4" aria-label="On this page">
                  <ul class="space-y-0.5">
                    {sections.map((s) => (
                      <li>
                        <a
                          href={`#${s.id}`}
                          data-toc-link={s.id}
                          class="legal-toc block rounded-md px-3 py-1.5 text-xs leading-snug text-slate-600 transition-colors hover:text-primary"
                        >
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            </aside>

            <!-- Content -->
            <article class="legal-content max-w-3xl">
              <slot />
            </article>

          </div>
        </div>
      </section>

      <!-- Footer CTA -->
      <section class="relative overflow-hidden bg-gray-600">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(200,169,81,0.12),transparent_60%)]" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-3xl px-4 py-16 text-center md:px-6 md:py-20">
          <h2 class="font-display-bold text-2xl text-white md:text-3xl">Questions about this document?</h2>
          <p class="mx-auto mt-3 max-w-xl text-sm text-white/70">
            Contact our interim Data Protection Officer or the Patient Support Desk. We answer within two working days.
          </p>
          <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="mailto:dpo@spmh.co.ke" class="inline-flex h-11 items-center gap-2 rounded-lg bg-accent px-5 text-sm font-semibold text-white hover:opacity-90">
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              dpo@spmh.co.ke
            </a>
            <a href="/faq" class="inline-flex h-11 items-center rounded-lg border border-white/25 px-5 text-sm font-semibold text-white hover:bg-white/10">
              Read the FAQ
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* Legal content typography */
      .legal-content :global(h2) {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 1.5rem;
        line-height: 1.3;
        letter-spacing: -0.01em;
        color: var(--color-secondary);
        margin-top: 3rem;
        margin-bottom: 1rem;
        scroll-margin-top: 6rem;
      }
      .legal-content :global(h2:first-child) {
        margin-top: 0;
      }
      .legal-content :global(h3) {
        font-weight: 700;
        font-size: 1rem;
        color: #0f172a;
        margin-top: 1.75rem;
        margin-bottom: 0.5rem;
        scroll-margin-top: 6rem;
      }
      .legal-content :global(p) {
        font-size: 0.9375rem;
        line-height: 1.7;
        color: #334155;
        margin-bottom: 1rem;
      }
      .legal-content :global(ul),
      .legal-content :global(ol) {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
      }
      .legal-content :global(ul) { list-style: disc; }
      .legal-content :global(ol) { list-style: decimal; }
      .legal-content :global(li) {
        font-size: 0.9375rem;
        line-height: 1.7;
        color: #334155;
        margin-bottom: 0.4rem;
      }
      .legal-content :global(li::marker) {
        color: var(--color-primary);
      }
      .legal-content :global(strong) {
        color: #0f172a;
        font-weight: 600;
      }
      .legal-content :global(a) {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .legal-content :global(a:hover) {
        color: var(--color-primary-dark);
      }
      .legal-content :global(.callout) {
        border-left: 3px solid var(--color-gold);
        background: #fefce8;
        padding: 1rem 1.25rem;
        border-radius: 0.5rem;
        margin: 1.5rem 0;
      }
      .legal-content :global(.callout p:last-child) {
        margin-bottom: 0;
      }
      .legal-content :global(table) {
        width: 100%;
        font-size: 0.875rem;
        border-collapse: collapse;
        margin: 1rem 0 1.5rem;
        border: 1px solid var(--color-border);
        border-radius: 0.5rem;
        overflow: hidden;
      }
      .legal-content :global(th) {
        text-align: left;
        background: var(--color-surface);
        font-weight: 700;
        color: #0f172a;
        padding: 0.625rem 0.875rem;
        border-bottom: 1px solid var(--color-border);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .legal-content :global(td) {
        padding: 0.625rem 0.875rem;
        border-bottom: 1px solid var(--color-border);
        color: #334155;
        vertical-align: top;
      }
      .legal-content :global(tr:last-child td) { border-bottom: none; }

      /* TOC active state */
      .legal-toc.is-active {
        color: var(--color-primary);
        font-weight: 600;
        background: color-mix(in srgb, var(--color-primary) 8%, transparent);
      }
    </style>

    <script>
      // Scroll spy for the TOC
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      if (links.length) {
        const targets = links
          .map((l) => document.getElementById(l.dataset.tocLink!))
          .filter((el): el is HTMLElement => el !== null);

        const setActive = (id: string) => {
          links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === id));
        };

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible[0]) setActive(visible[0].target.id);
          },
          { rootMargin: '-96px 0px -60% 0px', threshold: 0 }
        );

        targets.forEach((t) => observer.observe(t));
      }
    </script>
  </body>
</html>