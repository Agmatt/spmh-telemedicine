  <!-- Specialty tab logic -->
  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.spec-tab');
    const panels = document.querySelectorAll<HTMLElement>('[data-spec-panel]');

    function activate(idx: number) {
      tabs.forEach((t, i) => {
        const active = i === idx;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.classList.toggle('bg-primary', active);
        t.classList.toggle('text-white', active);
        t.classList.toggle('border-primary', active);
        t.classList.toggle('shadow-md', active);
        t.classList.toggle('bg-white', !active);
        t.classList.toggle('text-slate-700', !active);
        t.classList.toggle('border-border', !active);
        t.classList.toggle('hover:border-primary/40', !active);
      });
      panels.forEach((p, i) => {
        p.hidden = i !== idx;
      });
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => activate(i)));
    activate(0);
  </script>

