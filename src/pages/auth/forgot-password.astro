---
import AuthLayout from '../../layout/AuthLayout.astro';
import ForgotPasswordForm from '../../components/auth/ForgotPasswordForm.jsx';
import '../../styles/global.css';
---
<AuthLayout title="Forgot password — SPMH Telemedicine">
  <div class="mb-8">
    <h1 class="font-display-bold text-3xl text-secondary">Reset your password</h1>
    <p class="mt-2 text-sm text-slate-600">Enter the email you registered with. We'll send a reset link.</p>
  </div>
  <ForgotPasswordForm client:load />
</AuthLayout>