---
import AuthLayout from '../../layout/AuthLayout.astro';
import ResetPasswordForm from '../../components/auth/ResetPasswordForm.jsx';
import '../../styles/global.css';
---
<AuthLayout title="Reset password — SPMH Telemedicine">
  <div class="mb-8">
    <h1 class="font-display-bold text-3xl text-secondary">Choose a new password</h1>
    <p class="mt-2 text-sm text-slate-600">Enter and confirm your new password below.</p>
  </div>
  <ResetPasswordForm client:load />
</AuthLayout>