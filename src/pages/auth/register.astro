---
import AuthLayout from '../../layout/AuthLayout.astro';
import RegisterForm from '../../components/auth/RegisterForm.jsx';
import '../../styles/global.css'
---
<AuthLayout title="Create your account — SPMH Telemedicine">
  <div class="mb-8">
    <h1 class="font-bold text-3xl text-secondary">Create your account</h1>
    <p class="mt-2 text-sm text-slate-600">
      Two minutes to register. Then book a consultation with an SPMH specialist.
    </p>
  </div>
  <RegisterForm client:load />
</AuthLayout>