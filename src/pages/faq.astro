---
import LandingLayout from '../layout/LandingLayout.astro';
import { site } from '../data/site';

const categories = [
  {
    id: 'getting-started',
    label: 'Getting started',
    items: [
      { q: 'Do I need to be tech-savvy to use telemedicine?', a: 'No. If you can make a phone call or send a WhatsApp message, you can use telemedicine. Our portal is designed to be simple. If you get stuck, call our Patient Support Desk and we will walk you through it.' },
      { q: 'What if I do not have a smartphone?', a: 'Any device with a camera, microphone, and internet connection works — phone, tablet, or computer. If you only have a basic phone, we can arrange for you to join from an SPMH clinic computer.' },
      { q: 'What internet speed do I need?', a: 'A minimum of 2 Mbps works. Most 4G/LTE connections are fine. Wi-Fi is best. Test your connection before your appointment.' },
      { q: 'Do I need to be a current SPMH patient?', a: 'No. First-time patients are welcome. Our doctors take a full history at the start of the consultation.' },
    ],
  },
  {
    id: 'booking-payment',
    label: 'Booking & payment',
    items: [
      { q: 'How do I pay for my consultation?', a: 'During the pilot, payment is confirmed at the SPMH reception desk before your consultation. In-portal M-Pesa STK push is being finalised with Safaricom. You will be notified by SMS when M-Pesa goes live.' },
      { q: 'Can I cancel or reschedule?', a: 'Yes. Cancel or reschedule from your portal at any time. Cancellations 24+ hours before your appointment are free. Last-minute cancellations may carry a small fee to cover the doctor\'s time.' },
      { q: 'What if I booked the wrong specialty?', a: 'Call the Patient Support Desk. If it is within 24 hours of your appointment, we reschedule to the correct specialty at no extra cost.' },
      { q: 'Is there a refund if the doctor does not show up?', a: 'Yes — 100% refund if the doctor fails to join your consultation. Contact Patient Support within 24 hours of the missed appointment.' },
    ],
  },
  {
    id: 'consultation',
    label: 'During consultation',
    items: [
      { q: 'What if my internet drops during the call?', a: 'Rejoin the same video room using the link in your SMS or email. Your doctor will wait. If you are disconnected for more than 5 minutes, contact Patient Support to reschedule.' },
      { q: 'Can I have a family member with me?', a: 'Yes. Let your doctor know at the start of the consultation and they will allow it. For minors, a parent or guardian must be present.' },
      { q: 'What if the doctor needs to see me in person?', a: 'Your doctor will tell you during the consultation and can book you directly into the SPMH outpatient clinic at no additional booking fee.' },
      { q: 'Is my consultation recorded?', a: 'No. Consultations are not recorded unless you explicitly consent in writing. Your doctor writes a clinical note after the consultation, which you can view and download.' },
    ],
  },
  {
    id: 'prescriptions',
    label: 'Prescriptions & follow-up',
    items: [
      { q: 'How soon will I get my prescription?', a: 'Usually within 24 hours of the consultation. It appears in your patient portal. Download it as a PDF and take it to any licensed pharmacy. For urgent medications, call Patient Support.' },
      { q: 'Can I get a refill without a new consultation?', a: 'For chronic medications, yes. Request a refill from your portal. Your doctor reviews your history and approves if safe. Refill issued within 48 hours. No additional fee.' },
      { q: 'Will you deliver medications?', a: 'No. During the pilot, SPMH does not deliver medications. Collect from any licensed pharmacy by showing your e-prescription PDF.' },
      { q: 'Can I book the same doctor for a follow-up?', a: 'Yes. When booking, request the same doctor if available. Continuity of care matters, especially for chronic conditions.' },
    ],
  },
  {
    id: 'safety',
    label: 'Safety & privacy',
    items: [
      { q: 'Is my information kept private?', a: 'Yes. All consultations and records are encrypted end-to-end (TLS 1.3 in transit, AES-256 at rest). We comply with Kenya\'s Data Protection Act 2019. Every record view or edit is logged in an immutable audit trail.' },
      { q: 'Can someone else see my consultation?', a: 'No. Only you and your assigned doctor are in the video room. If you want a family member present, let us know and the doctor will allow it.' },
      { q: 'How long do you keep my data?', a: 'Clinical records are kept for 7 years, per Kenyan medical record-keeping standards. Audit logs and consent records are also kept for 7 years. Account data after cancellation is anonymised within 30 days.' },
      { q: 'What if I want my data deleted?', a: 'You can request deletion by writing to the DPO at dpo@spmh.co.ke. Clinical records required by law cannot be deleted until the retention period ends; everything else will be removed.' },
    ],
  },
  {
    id: 'costs',
    label: 'Costs & value',
    items: [
      { q: 'Is telemedicine cheaper than in-person visits?', a: 'The consultation fee is the same as in-person. You save on travel, time off work, and waiting-room time. For chronic disease follow-ups, telemedicine saves money long-term.' },
      { q: 'Will SHA or insurance cover this?', a: 'As of now, direct payment via M-Pesa or reception is required. SHA reimbursement guidance is pending national rollout. Contact your insurer to discuss whether telemedicine consultations are reimbursable.' },
      { q: 'Are there discounts for multiple consultations?', a: 'Not yet. Each consultation is charged at the standard specialty fee. We are exploring chronic-care packages for 2027.' },
    ],
  },
];

const allFaqs = categories.flatMap((c) => c.items);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://telemedicine.spmh.co.ke' },
        { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://telemedicine.spmh.co.ke/faq' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: allFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<LandingLayout
  title="FAQ — SPMH Telemedicine"
  description="Answers to the most common questions about SPMH Telemedicine: getting started, booking, payment, prescriptions, privacy, and costs."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <!-- Hero -->
  <section class="border-b border-border bg-white">
    <div class="mx-auto max-w-7xl px-4 pt-10 pb-12 md:px-6 md:pt-14 md:pb-16 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-xs text-muted">
          <li><a href="/" class="hover:text-primary">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-semibold text-slate-700">FAQ</li>
        </ol>
      </nav>

      <h1 class="mt-6 font-display-bold text-4xl text-secondary md:text-5xl">
        Frequently asked questions.
      </h1>
      <div class="mt-4 h-px w-12 bg-gold" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-600 md:text-lg">
        Everything you need to know before, during, and after your consultation. If your question is not here, contact us — we will answer directly.
      </p>
    </div>
  </section>

  <!-- Category filter -->
  <section class="sticky top-16 z-30 border-b border-border bg-white">
    <div class="mx-auto max-w-7xl px-4 py-3 md:px-6 lg:px-8">
      <div class="flex gap-2 overflow-x-auto pb-1" role="tablist" aria-label="FAQ categories">
        <button type="button" data-cat="all" class="faq-cat whitespace-nowrap rounded-full border px-4 py-2 text-xs font-semibold transition-colors" aria-pressed="true">
          All
        </button>
        {categories.map((c) => (
          <button type="button" data-cat={c.id} class="faq-cat whitespace-nowrap rounded-full border px-4 py-2 text-xs font-semibold transition-colors" aria-pressed="false">
            {c.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ list -->
  <section class="bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-12 md:px-6 md:py-16 lg:px-8">
      <div id="faq-groups" class="space-y-12">
        {categories.map((c) => (
          <div data-group={c.id}>
            <h2 class="font-display-bold text-2xl text-secondary md:text-3xl">{c.label}</h2>
            <div class="mt-4 h-px w-12 bg-gold" aria-hidden="true"></div>
            <div class="mt-6 space-y-3">
              {c.items.map((f) => (
                <details class="group rounded-xl border border-border bg-white p-5 transition-colors hover:border-primary/30">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold text-slate-900">
                    {f.q}
                    <svg class="h-4 w-4 flex-shrink-0 text-muted transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div id="no-results" hidden class="rounded-2xl border border-border bg-white p-12 text-center">
        <p class="font-display-bold text-lg text-secondary">Nothing in this category yet.</p>
      </div>
    </div>
  </section>

  <!-- Contact block -->
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-16 md:px-6 md:py-20 lg:px-8">
      <div class="rounded-3xl border border-border bg-surface p-8 md:p-12">
        <div class="grid gap-8 md:grid-cols-2 md:items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Still need help?</p>
            <h2 class="mt-4 font-display-bold text-2xl text-secondary md:text-3xl">Talk to the Patient Support Desk.</h2>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              If your question is not answered above, our team is here to help. Call, email, or visit the hospital reception in person.
            </p>
          </div>
          <div class="space-y-3">
            <a href={`tel:${site.contact.phone}`} class="flex items-center gap-3 rounded-xl border border-border bg-white p-4 transition-colors hover:border-primary/30">
              <span class="grid h-10 w-10 flex-shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-muted">Call</p>
                <p class="text-sm font-semibold text-slate-900">{site.contact.phone}</p>
              </div>
            </a>
            <a href={`mailto:${site.contact.email}`} class="flex items-center gap-3 rounded-xl border border-border bg-white p-4 transition-colors hover:border-primary/30">
              <span class="grid h-10 w-10 flex-shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-muted">Email</p>
                <p class="text-sm font-semibold text-slate-900">{site.contact.email}</p>
              </div>
            </a>
            <p class="flex items-center gap-2 text-xs text-muted">
              <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
              Available {site.contact.hours}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-gray-600">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(200,169,81,0.14),transparent_60%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-20 text-center md:px-6 md:py-24">
      <h2 class="font-display text-3xl text-white md:text-4xl">Ready to book?</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/70">
        Register in under two minutes. Book a specialist. Meet by secure video.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/auth/register" class="inline-flex h-12 items-center gap-2 rounded-lg bg-accent px-6 font-semibold text-white transition-opacity hover:opacity-90">
          Create your account
        </a>
        <a href="/how-it-works" class="inline-flex h-12 items-center gap-2 rounded-lg border border-white/25 px-6 font-semibold text-white transition-colors hover:bg-white/10">
          See how it works
        </a>
      </div>
    </div>
  </section>

  <script>
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.faq-cat');
    const groups = document.querySelectorAll<HTMLElement>('[data-group]');
    const noResults = document.getElementById('no-results');

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat!;

        catButtons.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', String(active));
          b.classList.toggle('bg-primary', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('border-primary', active);
          b.classList.toggle('bg-white', !active);
          b.classList.toggle('text-slate-700', !active);
          b.classList.toggle('border-border', !active);
          b.classList.toggle('hover:border-primary/40', !active);
        });

        let visible = 0;
        groups.forEach((g) => {
          const show = cat === 'all' || g.dataset.group === cat;
          g.hidden = !show;
          if (show) visible++;
        });

        if (noResults) noResults.hidden = visible > 0;
      });
    });

    // Initialise: "All" active
    const allBtn = document.querySelector<HTMLButtonElement>('.faq-cat[data-cat="all"]');
    if (allBtn) {
      allBtn.classList.add('bg-primary', 'text-white', 'border-primary');
      allBtn.classList.remove('bg-white', 'text-slate-700', 'border-border');
    }
    catButtons.forEach((b) => {
      if (b !== allBtn) b.classList.add('bg-white', 'text-slate-700', 'border-border', 'hover:border-primary/40');
    });
  </script>
</LandingLayout>