---
import LandingLayout from '../layout/LandingLayout.astro';

const clinicians = [
  { specialty: 'General Medicine', specialtySlug: 'general-medicine', icon: '<path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/>' },
    { specialty: 'Nutrition & Dietetics', specialtySlug: 'nutrition', icon: '<path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/><path d="M10 2c1 .5 2 2 2 5"/>' },
  { specialty: 'Paediatrics', specialtySlug: 'paediatrics', icon: '<path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5.9 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"/>' },
  { specialty: 'Obstetrics & Gynaecology', specialtySlug: 'obstetrics-gynaecology', icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>' },
  { specialty: 'General Surgery', specialtySlug: 'general-surgery', icon: '<path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/>' },
  { specialty: 'Dermatology', specialtySlug: 'dermatology', icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>' },
  { specialty: 'Ophthalmology', specialtySlug: 'ophthalmology', icon: '<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>' },
  { specialty: 'Dentistry', specialtySlug: 'dentistry', icon: '<path d="M12 5.5c-1.5-2-5-3-6.5 0S3 12 5 15c1.5 2 2 3 2.5 5 .3 1.2 1 1.5 1.5 1 .8-.7 1-2 1-3.5 0-2 1-2 2-2s2 0 2 2c0 1.5.2 2.8 1 3.5.5.5 1.2.2 1.5-1 .5-2 1-3 2.5-5 2-3 1-6.5-.5-9.5S13.5 3.5 12 5.5Z"/>' },
  { specialty: 'Mental Health & Counselling', specialtySlug: 'mental-health', icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>' },
];

const canonical = 'https://telemedicine.spmh.co.ke/doctors';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://telemedicine.spmh.co.ke' },
        { '@type': 'ListItem', position: 2, name: 'Doctors', item: canonical },
      ],
    },
    {
      '@type': 'MedicalWebPage',
      name: 'Our Doctors — SPMH Telemedicine',
      url: canonical,
      description: "The clinicians staffing SPMH's telemedicine panel across eight specialties.",
    },
  ],
};
---
<LandingLayout
  title="Our Doctors — SPMH Telemedicine"
  description="The SPMH clinicians staffing the telemedicine panel across eight specialties. Roster being finalised ahead of launch."
  noindex={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <!-- Compact hero with roster notice -->
  <section class="border-b border-border bg-white">
    <div class="mx-auto max-w-7xl px-4 pt-10 pb-12 md:px-6 md:pt-14 md:pb-16 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-xs text-muted">
          <li><a href="/" class="hover:text-primary">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-semibold text-slate-700">Doctors</li>
        </ol>
      </nav>

      <h1 class="mt-6 font-display-bold text-4xl text-secondary md:text-5xl">
        Our clinicians.
      </h1>
      <div class="mt-4 h-px w-12 bg-gold" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-600 md:text-lg">
        Every consultation is with a licensed SPMH clinician, verified through our credentialing process and covered by our clinical governance framework.
      </p>

      <!-- Roster notice -->
      <div class="mt-8 flex items-start gap-3 rounded-xl border border-gold/40 bg-gold/10 p-4">
        <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-gold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        <div class="text-sm leading-relaxed text-slate-800">
          <p class="font-semibold">Roster being finalised.</p>
          <p class="mt-1 text-slate-700">Our clinical panel is being completed ahead of launch. Register your interest below and we will contact you as each specialty becomes available.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Clinician cards (placeholder) -->
  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {clinicians.map((c) => (
          <article class="group flex flex-col rounded-2xl border border-border bg-white p-6 transition-all hover:border-primary/30 hover:shadow-md">
            <!-- Avatar placeholder -->
            <div class="relative">
              <div class="grid aspect-square w-full place-items-center rounded-xl bg-gradient-to-br from-secondary/10 to-primary/10">
                <svg class="h-16 w-16 text-secondary/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M20 8v6"/><path d="M23 11h-6"/></svg>
              </div>
              <span class="absolute right-2 top-2 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-muted backdrop-blur-sm">
                Coming soon
              </span>
            </div>

            <!-- Specialty label -->
            <div class="mt-6 flex items-center gap-2">
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
              </span>
              <p class="text-xs font-bold uppercase tracking-wider text-primary">{c.specialty}</p>
            </div>

            <p class="mt-3 font-display-bold text-lg text-secondary">SPMH Specialist</p>
            <p class="mt-1 text-xs text-muted">Profile available at launch</p>

            <a
              href={`/specialties#${c.specialtySlug}`}
              class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
            >
              See what they treat
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-ink">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(200,169,81,0.14),transparent_60%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-20 text-center md:px-6 md:py-24">
      <h2 class="font-display text-3xl text-white md:text-4xl">Be first to know when your specialty is live.</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/70">
        Register today. We will email you as soon as your preferred specialist starts taking consultations.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/auth/register" class="inline-flex h-12 items-center gap-2 rounded-lg bg-accent px-6 font-semibold text-white transition-opacity hover:opacity-90">
          Create your account
        </a>
        <a href="/specialties" class="inline-flex h-12 items-center gap-2 rounded-lg border border-white/25 px-6 font-semibold text-white transition-colors hover:bg-white/10">
          Browse specialties
        </a>
      </div>
    </div>
  </section>
</LandingLayout>