---
import LandingLayout from '../../layout/LandingLayout.astro';
import SetPasswordForm from '../../components/account/SetPasswordForm.jsx';
---
<LandingLayout title="Set password — SPMH Telemedicine" noindex={true}>
  <section class="bg-surface">
    <div class="mx-auto max-w-md px-4 py-10 md:px-6 md:py-14 lg:px-8">
      <div class="mb-8">
        <h1 class="font-display-bold text-2xl text-secondary">Set a new password</h1>
        <p class="mt-2 text-sm text-slate-600">Choose a password you'll remember. You can change it again anytime from Account settings.</p>
      </div>
      <SetPasswordForm client:load />
    </div>
  </section>
</LandingLayout>